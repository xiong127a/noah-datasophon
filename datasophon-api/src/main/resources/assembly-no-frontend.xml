<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">

    <id>package</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <useProjectArtifact>true</useProjectArtifact>
            <outputDirectory>lib</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
            <excludes>
                <!-- 排除该包，否则多个日志框架导致无法直接启动，需要手动删除 -->
                <exclude>*:log4j</exclude>
                <exclude>*:slf4j-log4j12</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <!--拷贝application.yml文件到jar包的外部conf目录下面-->
        <fileSet>
            <directory>${basedir}/../datasophon-api/src/main/resources</directory>
            <includes>
                <include>logback-api.xml</include>
                <include>application.conf</include>
                <include>application.yml</include>
            </includes>
            <outputDirectory>conf</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../</directory>
            <includes>
                <include>LICENSE</include>
                <include>README.md</include>
            </includes>
        </fileSet>
        <!--拷贝start.sh启动脚本文件到bin目录下面-->
        <fileSet>
            <directory>${basedir}/../bin</directory>
            <includes>
                <include>*.sh</include>
            </includes>
            <fileMode>0755</fileMode>
            <directoryMode>0755</directoryMode>
            <filtered>true</filtered>
            <outputDirectory>bin</outputDirectory>
            <!-- Linux 脚本，需要打包为 unix 格式，否则换行可能有问题 -->
            <lineEnding>unix</lineEnding>
        </fileSet>


        <fileSet>
            <directory>${basedir}/../datasophon-api/src/main/resources/meta</directory>
            <outputDirectory>conf/meta</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../datasophon-api/src/main/resources/templates</directory>
            <outputDirectory>conf/templates</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../jmx</directory>
            <outputDirectory>/jmx</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- 删除前端资源复制 -->
        <fileSet>
            <directory>${basedir}/../conf</directory>
            <outputDirectory>/conf</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
            <includes>
                <include>**</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/resources/db/migration</directory>
            <outputDirectory>/conf/db/migration</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
            <includes>
                <include>**</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../deploy/docker</directory>
            <includes>
                <include>Dockerfile</include>
            </includes>
            <outputDirectory>/</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../deploy/compose</directory>
            <includes>
                <include>**</include>
            </includes>
            <outputDirectory>/bin/compose</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../datasophon-init/</directory>
            <includes>
                <include>**/*.*</include>
            </includes>
            <outputDirectory>datasophon-init</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>

        <fileSet>
            <directory>${basedir}/src/main/resources/worker/templates</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <outputDirectory>conf/worker/templates</outputDirectory>
            <fileMode>0755</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../datasophon-kubernetes/src/main/resources</directory>
            <includes>
                <include>**/*.properties</include>
            </includes>
            <outputDirectory>conf</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../datasophon-kubernetes/src/main/resources/kubernetes</directory>
            <outputDirectory>conf/kubernetes</outputDirectory>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${basedir}/../arthas</directory>
            <outputDirectory>arthas</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/resources</directory>
            <includes>
                <include>**/*.properties</include>
                <include>**/*.xml</include>
                <include>**/*.yml</include>
                <include>init-scripts.properties</include>
            </includes>
            <outputDirectory>conf</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        
        <!-- 添加datasophon-api/src/main/resources/docs目录 -->
        <fileSet>
            <directory>${basedir}/src/main/resources/docs</directory>
            <includes>
                <include>**/*</include>
            </includes>
            <outputDirectory>conf/docs</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0644</fileMode>
        </fileSet>
        
        <!-- 插件目录 - 自动包含所有核心插件JAR -->
        <fileSet>
            <directory>${basedir}/../datasophon-plugins</directory>
            <includes>
                <include>**/target/*-plugin.jar</include>
                <include>**/target/dev-plugins/*.jar</include>
            </includes>
            <excludes>
                <exclude>**/*-sources.jar</exclude>
                <exclude>**/*-javadoc.jar</exclude>
                <exclude>**/*-jar-with-dependencies.jar</exclude>
            </excludes>
            <outputDirectory>plugins</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0755</fileMode>
        </fileSet>
    </fileSets>
</assembly> 