      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "http://${dfs.namenode.http-address.nameservice1.nn1}/webhdfs/v1"
    },
    {
      "name": "hadoopConfDir",
      "label": "hadoop配置文件路径",
