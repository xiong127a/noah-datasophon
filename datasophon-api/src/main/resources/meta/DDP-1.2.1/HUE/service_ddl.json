      "type": "input",
      "value": "hdfs://${dfs.namenode.rpc-address.nameservice1.nn1}",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hdfs://${dfs.namenode.rpc-address.nameservice1.nn1}"
