    {
      "name": "hueHiveSecurityEnable",
      "label": "hueHiveSecurityEnable",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "${enableHIVEKerberos}",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${enableHIVEKerberos}"
