{
  "name": "HUE",
  "label": "HUE",
  "description": "开源的Apache Hadoop UI系统",
  "version": "4.11.0",
  "sortNum": 38,
  "dependencies": [],
  "packageName": "hue-4.11.0.tar.gz",
  "decompressPackageName": "hue-4.11.0",
  "roles": [
    {
      "name": "HueMaster",
      "label": "HueMaster",
      "roleType": "master",
      "cardinality": "1",
      "runAs": {
        "user": "hue",
        "group": "hue"
      },
      "logFile": "logs/runcpserver.log",
      "startRunner": {
        "timeout": "60",
        "program": "control_hue.sh",
        "args": [
          "start"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_hue.sh",
        "args": [
          "stop"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_hue.sh",
        "args": [
          "status"
        ]
      },
      "externalLink": {
        "name": "hue UI",
        "label": "hue UI",
        "url": "http://${host}:8777"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "pseudo-distributed.ini",
        "configFormat": "custom",
        "outputDirectory": "desktop/conf",
        "templateName": "pseudo-distributed.ftl",
        "includeParams": [
          "dbEngine",
          "dbHost",
          "dbPort",
          "dbUser",
          "dbPass",
          "dbName",
          "defaultHdfsSuperuser",
          "fsDefaultfs",
          "logicalName",
          "webhdfsUrl",
          "hadoopConfDir",
          "resourcemanagerHost",
          "resourcemanagerApiUrl",
          "proxyApiUrl",
          "historyServerApiUrl",
          "sparkHistoryServerUrl",
          "hiveServerHost",
          "hiveServerPort",
          "hiveConfDir"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "dbEngine",
      "label": "数据库类型",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "mysql",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "mysql"
    },
    {
      "name": "dbHost",
      "label": "数据库ip",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "hadoop1",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hadoop1"
    },
    {
      "name": "dbPort",
      "label": "数据库端口",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "3306",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "3306"
    },
    {
      "name": "dbUser",
      "label": "数据库用户",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "hue",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hue"
    },
    {
      "name": "dbPass",
      "label": "数据库密码",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "123456",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "123456"
    },
    {
      "name": "dbName",
      "label": "数据库名称",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "hue",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hue"
    },
    {
      "name": "defaultHdfsSuperuser",
      "label": "hdfs超级用户名",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "hdfs",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "hdfs"
    },
    {
      "name": "fsDefaultfs",
      "label": "namenode rpc通信地址",
