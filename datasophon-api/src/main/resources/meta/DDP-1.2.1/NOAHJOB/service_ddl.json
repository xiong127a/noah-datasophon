{
  "name": "NOAHJOB",
  "label": "NoahJob",
  "description": "分布式易扩展的可视化工作流任务调度平台",
  "version": "3.0.0",
  "sortNum": 44,
  "dependencies":["ZOOKEEPER"],
  "packageName": "noah-job-3.0.0.tar.gz",
  "decompressPackageName": "noah-job-3.0.0",
  "roles": [
    {
      "name": "NoahJobServer",
      "label": "NoahJobServer",
      "roleType": "master",
      "cardinality": "1",
      "logFile": "standalone-server/logs/standalone-server-${host}.out",
      "jmxPort": 12367,
      "startRunner": {
        "timeout": "60",
        "program": "bin/dolphinscheduler-daemon.sh",
        "args": [
          "start",
          "standalone-server"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "bin/dolphinscheduler-daemon.sh",
        "args": [
          "stop",
          "standalone-server"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/dolphinscheduler-daemon.sh",
        "args": [
          "status",
          "standalone-server"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "bin/restart-dolphinscheduler.sh",
        "args": [
          "standalone-server"
        ]
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "application.yaml",
        "configFormat": "custom",
        "outputDirectory": "standalone-server/conf",
        "templateName": "noah-job-app.ftl",
        "includeParams": [
          "driverClassName",
          "databaseUrl",
          "username",
          "password",
          "zkUrls",
          "authUrl",
          "serverUrl",
          "redisAloneEnabled",
          "redisAloneHost",
          "redisAlonePort",
          "redisNodes",
          "redisPassword",
          "orgQuartzJobStoreDriverDelegateClass"
        ]
      },
      {
        "filename": "common.properties",
        "configFormat": "properties",
        "outputDirectory": "standalone-server/conf",
        "includeParams": [
          "data.basedir.path",
          "resource.storage.type",
          "resource.upload.path",
          "aws.access.key.id",
          "aws.secret.access.key",
          "aws.region",
          "aws.bucket",
          "aws.datasource.authentication.bucket",
          "aws.endpoint",
          "resource.alibaba.cloud.access.key.id",
          "resource.alibaba.cloud.access.key.secret",
          "resource.alibaba.cloud.region",
          "resource.alibaba.cloud.oss.bucket.name",
          "resource.alibaba.cloud.oss.endpoint",
          "hdfs.root.user",
          "noahjob.fs.defaultFS",
          "hadoop.security.authentication.startup.state",
          "java.security.krb5.conf.path",
          "login.user.keytab.username",
          "login.user.keytab.path",
          "kerberos.expire.time",
          "resource.manager.httpaddress.port",
          "yarn.resourcemanager.ha.rm.ids",
          "yarn.application.status.address",
          "yarn.job.history.status.address",
          "datasource.encryption.enable",
          "datasource.encryption.salt",
          "data-quality.jar.name",
          "support.hive.oneSession",
          "sudo.enable",
          "development.state",
          "alert.rpc.port",
          "zeppelin.rest.url",
          "portal.url",
          "custom.common.properties"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "driverClassName",
      "label": "DolphinScheduler数据库驱动",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "com.mysql.cj.jdbc.Driver"
    },
    {
      "name": "databaseUrl",
      "label": "DolphinScheduler数据库地址",
