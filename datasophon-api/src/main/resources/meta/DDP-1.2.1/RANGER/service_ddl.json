                "timeout": "60",
                "program": "bin/ranger_admin.sh",
                "args": [
                    "start"
                ]
            },
            "stopRunner": {
                "timeout": "600",
                "program": "bin/ranger_admin.sh",
                "args": [
                    "stop"
                ]
            },
            "statusRunner": {
                "timeout": "60",
                "program": "bin/ranger_admin.sh",
                "args": [
                    "status"
                ]
            },
            "externalLink": {
                "name": "RangerAdmin Ui",
                "label": "RangerAdmin Ui",
                "url": "http://${host}:6080"
            }
        },
        {
            "name": "RangerUsersync",
            "label": "RangerUsersync",
            "roleType": "master",
            "runAs": {
                "user": "root",
                "group": "root"
            },
            "cardinality": "1",
            "logFile": "ranger-2.1.0-usersync/logs/usersync-${host}-root.log",
            "jmxPort": "",
            "sortNum": 2,
            "startRunner": {
                "timeout": "60",
                "program": "ranger-2.1.0-usersync/ranger_usersync.sh",
                "args": [
                    "start"
                ]
            },
            "stopRunner": {
                "timeout": "600",
                "program": "ranger-2.1.0-usersync/ranger_usersync.sh",
                "args": [
                    "stop"
                ]
            },
            "statusRunner": {
                "timeout": "60",
                "program": "ranger-2.1.0-usersync/ranger_usersync.sh",
                "args": [
                    "status"
                ]
            },
            "restartRunner": {
                "timeout": "60",
                "program": "ranger-2.1.0-usersync/ranger_usersync.sh",
                "args": [
                    "restart"
                ]
            }
        },
        {
            "name": "RangerKms",
            "label": "RangerKms",
            "roleType": "master",
            "runAs": {
                "user": "root",
                "group": "root"
            },
