{
  "name": "FLINK",
  "label": "Flink",
  "description": "实时计算引擎",
  "version": "1.16.2",
  "sortNum": 6,
  "dependencies":[],
  "packageName": "flink-1.16.2.tar.gz",
  "decompressPackageName": "flink-1.16.2",
  "runAs":"root",
  "roles": [
    {
      "name": "FlinkClient",
      "label": "FlinkClient",
      "roleType": "client",
      "cardinality": "1+",
      "logFile": "logs/flink.log"
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "flink-conf.yaml",
        "fileDescription": "Flink核心配置文件，定义JobManager、TaskManager内存和高可用参数",
        "configFormat": "custom",
        "templateName": "properties3.ftl",
        "outputDirectory": "conf",
        "includeParams": [
          "jobmanager.memory.heap.size",
          "taskmanager.memory.flink.size",
          "high-availability",
          "high-availability.storageDir",
          "high-availability.zookeeper.quorum",
          "high-availability.zookeeper.client.acl",
          "high-availability.zookeeper.path.root",
          "classloader.check-leaked-classloader",
          "metrics.reporter.promgateway.factory.class",
          "metrics.reporter.promgateway.hostUrl",
          "metrics.reporter.promgateway.jobName",
          "metrics.reporter.promgateway.randomJobNameSuffix",
          "metrics.reporter.promgateway.deleteOnShutdown",
          "metrics.reporter.promgateway.interval",
          "custom.flink.conf.yaml"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "jobmanager.memory.heap.size",
      "label": "jobmanager堆内存大小",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1600m"
    },
    {
      "name": "taskmanager.memory.flink.size",
      "label": "taskmanager堆内存大小",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1280m"
    },
    {
      "name": "enableJMHA",
      "label": "开启JobManager高可用",
      "description": "",
      "required": true,
      "type": "switch",
      "value": false,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "high-availability",
      "label": "使用zookeeper搭建高可用",
      "description": "使用zookeeper搭建高可用",
      "configWithHA": true,
      "required": false,
      "type": "input",
      "value": "zookeeper",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": "zookeeper"
    },{
      "name": "high-availability.storageDir",
      "label": "元数据存储HDFS目录",
      "description": "存储JobManager的元数据到HDFS",
      "configWithHA": true,
      "required": false,
      "type": "input",
      "value": "hdfs://nameservice1/flink/ha/",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": "hdfs://nameservice1/flink/ha/"
    },{
      "name": "high-availability.zookeeper.quorum",
      "label": "ZK集群地址",
      "description": "配置ZK集群地址",
      "configWithHA": true,
      "required": false,
      "type": "input",
      "value": "${zkUrls}",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": ""
    },
    {
      "name": "high-availability.zookeeper.path.root",
      "label": "ZK元数据目录",
      "description": "配置ZK元数据目录",
      "configWithHA": true,
      "required": false,
      "type": "input",
      "value": "/flink",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": "/flink"
    },
    {
      "name": "high-availability.zookeeper.client.acl",
      "label": "high-availability.zookeeper.client.acl",
      "description": "默认是 open，如果zookeeper security启用了更改成creator",
      "configWithHA": true,
      "required": false,
      "type": "input",
      "value": "open",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": "open"
    },
    {
      "name": "custom.flink.conf.yaml",
      "label": "自定义配置flink-conf.yaml",
      "description": "自定义配置",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "classloader.check-leaked-classloader",
      "label": "禁用classloader.check",
      "description": "禁用classloader.check",
      "required": true,
      "type": "switch",
      "value": false,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "metrics.reporter.promgateway.factory.class",
      "label": "监控实现类",
      "description": "监控实现类",
      "required": true,
      "type": "input",
      "value": "org.apache.flink.metrics.prometheus.PrometheusPushGatewayReporterFactory",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "org.apache.flink.metrics.prometheus.PrometheusPushGatewayReporterFactory"
    },
    {
      "name": "metrics.reporter.promgateway.hostUrl",
      "label": "pushgateway地址",
      "description": "pushgateway地址",
      "required": true,
      "type": "input",
      "value": "http://${pushgatewayHost}:9091",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "http://${pushgatewayHost}:9091"
    },
    {
      "name": "metrics.reporter.promgateway.jobName",
      "label": "Flink metric在前端展示的标签(前缀)",
      "description": "Flink metric在前端展示的标签(前缀)",
      "required": true,
      "type": "input",
      "value": "flink-metrics",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "flink-metrics"
    },
    {
      "name": "metrics.reporter.promgateway.randomJobNameSuffix",
      "label": "是否在Flink metric的标签添加随机后缀",
      "description": "是否在Flink metric的标签添加随机后缀",
      "required": true,
      "type": "switch",
      "value": true,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true
    },
    {
      "name": "metrics.reporter.promgateway.deleteOnShutdown",
      "label": "Flink集群关闭时，是否删除Pushgateway中的Flink metrics",
      "description": "",
      "required": true,
      "type": "switch",
      "value": false,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "metrics.reporter.promgateway.interval",
      "label": "Flink向Pushgateway推送metrics的时间间隔",
      "description": "Flink向Pushgateway推送metrics的时间间隔",
      "required": true,
      "type": "input",
      "value": "30 SECONDS",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "30 SECONDS"
    }
  ]
}