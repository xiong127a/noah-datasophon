{
  "name": "ALERTMANAGER",
  "label": "AlertManager",
  "description": "告警通知管理系统",
  "version": "0.23.0",
  "sortNum": 15,
  "dependencies": [],
  "packageName": "alertmanager-0.23.0.tar.gz",
  "decompressPackageName": "alertmanager-0.23.0",
  "roles": [
    {
      "name": "AlertManager",
      "label": "AlertManager",
      "roleType": "master",
      "runAs": {
        "user": "root",
        "group": "root"
      },
      "cardinality": 1,
      "logFile": "logs/alertmanager-${host}.out",
      "jmxPort": 9093,
      "startRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "start",
          "alertmanager"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control.sh",
        "args": [
          "stop",
          "alertmanager"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "status",
          "alertmanager"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "restart",
          "alertmanager"
        ]
      },
      "externalLink": {
        "name": "AlertManager Ui",
        "label": "AlertManager Ui",
        "url": "http://${host}:9093"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "alertmanager.yml",
        "configFormat": "custom",
        "fileDescription": "AlertManager配置文件，用于定义告警路由、接收器和通知方式等配置信息",
        "outputDirectory": "",
        "configTargetRoles": "AlertManager",
        "templateName": "alertmanager.yml",
        "includeParams": [
          "apiUrl",
          "smtpSmarthost",
          "smtpFrom",
          "smtpAuthUsername",
          "smtpAuthPassword"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "apiUrl",
      "label": "DDH管理端地址",
      "description": "DDH管理端地址",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${apiHost}:${apiPort}"
    },
    {
      "name": "emailEnable",
      "label": "启用告警邮箱通知",
      "description": "启用告警邮箱通知",
      "configType": "map",
      "required": true,
      "type": "switch",
      "value": true,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "smtpSmarthost",
      "label": "邮箱SMTP服务器地址和端口",
      "description": "配置邮箱 SMTP 服务器地址和端口",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "smtp.xxx.com:25"
    },
    {
      "name": "smtpFrom",
      "label": "发件人邮箱",
      "description": "发件人邮箱",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "xxx@xx.com"
    },
    {
      "name": "smtpAuthUsername",
      "label": "发件人邮箱账户",
      "description": "发件人邮箱账户",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1"
    },
    {
      "name": "smtpAuthPassword",
      "label": "发件人邮箱密码",
      "description": "发件人邮箱密码",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1"
    }
  ]
}
