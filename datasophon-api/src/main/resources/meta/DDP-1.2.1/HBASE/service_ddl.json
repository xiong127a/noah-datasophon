{
  "name": "HBASE",
  "label": "HBase",
  "description": "分布式列式海量存储数据库",
  "version": "2.2.7",
  "sortNum": 8,
  "dependencies": [
    "HDFS"
  ],
  "packageName": "hbase-2.2.7.tar.gz",
  "decompressPackageName": "hbase-2.2.7",
  "runAs": "root",
  "roles": [
    {
      "name": "HbaseMaster",
      "label": "HbaseMaster",
      "sortNum": 1,
      "roleType": "master",
      "runAs": {
        "user": "hbase",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "logFile": "logs/hbase-hbase-master-${hostname}.log",
      "jmxPort": 16100,
      "startRunner": {
        "timeout": "60",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "start",
          "master"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "stop",
          "master"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "status",
          "master"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "restart",
          "master"
        ]
      },
      "externalLink": {
        "name": "HbaseMaster Ui",
        "label": "HbaseMaster Ui",
        "url": "http://${hostname}:16010"
      }
    },
    {
      "name": "RegionServer",
      "label": "RegionServer",
      "roleType": "worker",
      "runAs": {
        "user": "hbase",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "logFile": "logs/hbase-hbase-regionserver-${hostname}.log",
      "jmxPort": 16101,
      "startRunner": {
        "timeout": "60",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "start",
          "regionserver"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "stop",
          "regionserver"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "status",
          "regionserver"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "bin/hbase-daemon.sh",
        "args": [
          "restart",
          "regionserver"
        ]
      }
    },
    {
      "name": "PhoenixQueryServer",
      "label": "PhoenixQueryServer",
      "sortNum": 2,
      "roleType": "master",
      "runAs": {
        "user": "hbase",
        "group": "hadoop"
      },
      "cardinality": "1+",
      "logFile": "logs/phoenix-queryserver-${hostname}.log",
      "startRunner": {
        "timeout": "60",
        "program": "phoenix/bin/queryserver_control.sh",
        "args": [
          "start"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "phoenix/bin/queryserver_control.sh",
        "args": [
          "stop"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "phoenix/bin/queryserver_control.sh",
        "args": [
          "status"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "phoenix/bin/queryserver_control.sh",
        "args": [
          "restart"
        ]
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "hbase-site.xml",
        "fileDescription": "HBase核心配置文件，定义存储路径、ZooKeeper连接和安全认证参数",
        "configFormat": "xml",
        "outputDirectory": "conf",
        "includeParams": [
          "hbase.cluster.distributed",
          "hbase.master.port",
          "hbase.master.info.port",
          "hbase.regionserver.port",
          "hbase.master.hostname",
          "phoenix.queryserver.port",
          "phoenix.queryserver.http.port",
          "hbase.rootdir",
          "hbase.zookeeper.quorum",
          "hbase.wal.provider",
          "hbase.unsafe.stream.capability.enforce",
          "hbase.security.authentication",
          "hbase.rpc.engine",
          "hbase.coprocessor.region.classes",
          "hbase.master.kerberos.principal",
          "hbase.master.keytab.file",
          "hbase.regionserver.kerberos.principal",
          "hbase.regionserver.keytab.file",
          "hbase.quota.enabled",
          "phoenix.schema.mapSystemTablesToNamespace",
          "phoenix.schema.isNamespaceMappingEnabled",
          "phoenix.queryserver.loadbalancer.enabled",
          "phoenix.queryserver.base.path",
          "phoenix.queryserver.service.name",
          "phoenix.queryserver.keytab.file",
          "phoenix.queryserver.kerberos.principal",
          "phoenix.queryserver.http.keytab.file",
          "phoenix.queryserver.http.kerberos.principal",
          "custom.hbase.site.xml"
        ]
      },
      {
        "filename": "install.properties",
        "fileDescription": "Ranger HBase插件配置文件，设置权限管理和审计参数",
        "configFormat": "custom",
        "outputDirectory": "ranger-hbase-plugin",
        "templateName": "ranger-hbase.ftl",
        "includeParams": [
          "rangerAdminUrl",
          "hbaseHome",
          "esAuditEnable",
          "esSingleHost",
          "esHttpPort"
        ]
      },
      {
        "filename": "zk-jaas.conf",
        "fileDescription": "ZooKeeper认证配置文件，设置Kerberos安全认证参数",
        "configFormat": "custom",
        "outputDirectory": "conf",
        "templateName": "zk-jaas.ftl",
        "includeParams": [
          "hostname"
        ]
      },
      {
        "filename": "hbase-env.sh",
        "fileDescription": "HBase环境变量脚本，设置进程ID目录、日志路径和安全配置",
        "configFormat": "custom",
        "outputDirectory": "conf",
        "templateName": "hbase-env.ftl",
        "includeParams": [
          "hbasePidDir",
          "hbaseLogDir",
          "hbaseSecurity",
          "custom.hbase.env.sh"
        ]
      },
      {
        "filename": "kubernetes.config.persistent-volume-claims",
        "fileDescription": "Hbase Kubernetes存储配置，定义持久卷存储类和挂载路径",
        "configFormat": "properties",
        "configTargetRoles": "HbaseMaster,RegionServer,PhoenixQueryServer",
        "outputDirectory": "",
        "includeParams": [
          "storage_classes",
          "mount_path",
          "storage_size"
        ]
      },
      {
        "filename": "kubernetes.config.services",
        "fileDescription": "Hbase Kubernetes网络服务配置，定义端口",
        "configFormat": "properties",
        "configTargetRoles": "HbaseMaster,RegionServer,PhoenixQueryServer",
        "outputDirectory": "",
        "includeParams": [
          "node_port_mappings",
          "cluster_port_mappings"
        ]
      },
      {
        "filename": "kubernetes.config.resources",
        "fileDescription": "cpu、memory系统资源",
        "configFormat": "properties",
        "configTargetRoles": "HbaseMaster,RegionServer,PhoenixQueryServer",
        "outputDirectory": "",
        "includeParams": [
          "requests_memory",
          "requests_cpu",
          "limits_memory",
          "limits_cpu"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "hbase.cluster.distributed",
      "label": "HBase集群模式",
      "description": "HBase是否以分布式模式运行。设置为'true'表示分布式模式，'false'表示单机模式",
