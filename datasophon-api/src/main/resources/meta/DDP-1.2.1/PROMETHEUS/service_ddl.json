{
  "name": "PROMETHEUS",
  "label": "Prometheus",
  "description": "高性能监控指标采集与告警系统",
  "version": "2.17.2",
  "sortNum": 16,
  "dependencies": [],
  "packageName": "prometheus-2.17.2.tar.gz",
  "decompressPackageName": "prometheus-2.17.2",
  "roles": [
    {
      "name": "Prometheus",
      "label": "Prometheus",
      "roleType": "master",
      "runAs": {
        "user": "root",
        "group": "root"
      },
      "cardinality": 1,
      "logFile": "logs/prometheus-${host}.out",
      "jmxPort": 9090,
      "startRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "start",
          "prometheus"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control.sh",
        "args": [
          "stop",
          "prometheus"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "status",
          "prometheus"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "restart",
          "prometheus"
        ]
      },
      "externalLink": {
        "name": "Prometheus Ui",
        "label": "Prometheus Ui",
        "url": "http://${host}:9090"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "prometheus.yml",
        "configFormat": "custom",
        "fileDescription": "Prometheus配置文件，用于定义Prometheus的配置信息",
        "outputDirectory": "",
        "templateName": "prometheus.ftl",
        "includeParams": [
          "scrape_interval",
          "evaluation_interval"
        ]
      },
      {
        "filename": "svc.config.k8s",
        "fileDescription": "prometheus Kubernetes网络服务配置，定义端口",
        "configFormat": "properties",
        "configTargetRoles": "Prometheus",
        "outputDirectory": "",
        "includeParams": [
          "portMappings"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "scrape_interval",
      "label": "Prometheus指标采集时间间隔",
      "description": "Prometheus指标采集时间间隔，单位秒",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "15",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "15"
    },
    {
      "name": "evaluation_interval",
      "label": "Prometheus指标计算时间间隔",
      "description": "Prometheus指标计算时间间隔，单位秒",
      "required": true,
      "configType": "map",
      "type": "input",
      "value": "15",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "15"
    },
    {
      "name": "portMappings",
      "label": "端口映射 (portMappings)",
      "description": "定义容器与主机之间的端口映射关系，用于网络通信。key 表示 port 和 targetPort（port 和 targetPort 使用同一个端口），value 表示 nodePort。如果 value 为空，则表示不开放 nodePort。",
      "configType": "k8s",
      "required": false,
      "type": "multipleWithKey",
      "value": [
        {
          "9090": "30909"
        }
      ],
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": [
        {
          "9090": "30909"
        }
      ]
    }
  ]
}