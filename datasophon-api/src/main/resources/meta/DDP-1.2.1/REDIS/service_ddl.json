{
  "name": "REDIS",
  "label": "REDIS",
  "description": "内存存储的数据结构服务器",
  "version": "7.2.3",
  "sortNum": 37,
  "dependencies": [],
  "packageName": "redis-7.2.3.tar.gz",
  "decompressPackageName": "redis-7.2.3",
  "roles": [
    {
      "name": "RedisMaster",
      "label": "RedisMaster",
      "roleType": "master",
      "cardinality": "1+",
      "sortNum": 1,
      "logFile": "cluster/log/cluster-master.log",
      "startRunner": {
        "timeout": "60",
        "program": "control_redis.sh",
        "args": [
          "start",
          "master"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_redis.sh",
        "args": [
          "stop",
          "master"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_redis.sh",
        "args": [
          "status",
          "master"
        ]
      }
    },
    {
      "name": "RedisWorker",
      "label": "RedisWorker",
      "roleType": "worker",
      "cardinality": "1+",
      "sortNum": 1,
      "logFile": "cluster/log/cluster-slave.log",
      "startRunner": {
        "timeout": "60",
        "program": "control_redis.sh",
        "args": [
          "start",
          "slave"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_redis.sh",
        "args": [
          "stop",
          "slave"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_redis.sh",
        "args": [
          "status",
          "slave"
        ]
      }
    },
    {
      "name": "RedisExporter",
      "label": "RedisExporter",
      "roleType": "worker",
      "cardinality": "1",
      "sortNum": 2,
      "logFile": "redis_exporter/logs/redis-${hostname}.out",
      "startRunner": {
        "timeout": "60",
        "program": "redis_exporter/control_redis_exporter.sh",
        "args": [
          "start",
          "redis"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "redis_exporter/control_redis_exporter.sh",
        "args": [
          "stop",
          "redis"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "redis_exporter/control_redis_exporter.sh",
        "args": [
          "status",
          "redis"
        ]
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "control_redis.sh",
        "fileDescription": "Redis控制脚本，用于启动、停止和检查Redis服务状态",
        "configFormat": "custom",
        "outputDirectory": "",
        "templateName": "redis-control.ftl",
        "includeParams": [
          "redisMasterPort",
          "redisSlavePort"
        ]
      },
      {
        "filename": "redis-master.conf",
        "fileDescription": "Redis主节点配置文件，定义主节点的端口、内存和持久化参数",
        "configFormat": "custom",
        "configTargetRoles": "RedisMaster",
        "outputDirectory": "cluster/conf",
        "templateName": "redis-master.ftl",
        "includeParams": [
          "redisMasterPort",
          "custom.master.conf"
        ]
      },
      {
        "filename": "redis-slave.conf",
        "fileDescription": "Redis从节点配置文件，定义从节点的端口和与主节点复制参数",
        "configFormat": "custom",
        "configTargetRoles": "RedisWorker",
        "outputDirectory": "cluster/conf",
        "templateName": "redis-slave.ftl",
        "includeParams": [
          "redisSlavePort",
          "custom.slave.conf"
        ]
      },
      {
        "filename": "redis-cluster.sh",
        "fileDescription": "Redis集群构建脚本，用于创建和管理Redis集群节点",
        "configFormat": "custom",
        "outputDirectory": "",
        "templateName": "redis-cluster.ftl",
        "includeParams": [
          "RedisMasterAddr",
          "RedisSlaveAddr"
        ]
      },
      {
        "filename": "control_redis_exporter.sh",
        "fileDescription": "Redis监控导出器控制脚本，用于收集Redis指标数据",
        "configFormat": "custom",
        "outputDirectory": "redis_exporter",
        "templateName": "redis-control-exporter.ftl",
        "includeParams": [
          "redisMasterPort"
        ]
      },
      {
        "filename": "redis.json",
        "fileDescription": "Redis监控指标配置文件，定义Prometheus收集的指标项",
        "configFormat": "custom",
        "configTargetRoles": "RedisExporter",
        "outputDirectory": "redis_exporter",
        "templateName": "redis-metric-json.ftl",
        "includeParams": [
          "redisMetricHosts"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "redisMasterPort",
      "label": "master节点端口号",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "7000",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "7000"
    },
    {
      "name": "redisSlavePort",
      "label": "worker节点端口号",
      "description": "",
      "configType": "map",
      "required": true,
      "type": "input",
      "value": "7001",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "7001"
    },
    {
      "name": "custom.master.conf",
      "label": "自定义master配置",
      "description": "自定义master配置",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "custom.slave.conf",
      "label": "自定义worker配置",
      "description": "自定义worker配置",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "RedisMasterAddr",
      "label": "RedisMasterAddr",
      "description": "",
      "configType": "map",
      "required": false,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": ""
    },
    {
      "name": "RedisSlaveAddr",
      "label": "RedisSlaveAddr",
      "description": "",
      "configType": "map",
      "required": false,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": ""
    },
    {
      "name": "redisMetricHosts",
      "label": "redis监控节点地址",
      "description": "redis监控节点地址",
      "required": true,
      "separator":",",
      "configType": "map",
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": ""
    }
  ]
}