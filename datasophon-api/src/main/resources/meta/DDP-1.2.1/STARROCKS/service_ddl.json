          "spill_local_storage_dir",
          "block_cache_enable",
          "block_cache_disk_path",
          "block_cache_mem_size",
          "block_cache_disk_size"
        ]
      },
      {
        "filename": "cn.conf",
        "configFormat": "properties",
        "outputDirectory": "be/conf",
