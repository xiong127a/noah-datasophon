    {
      "name": "node_port_mappings",
      "label": "NodePort端口映射",
      "description": "配置Kubernetes Service的NodePort类型端口映射，实现集群外部对服务的访问。键(key)指定容器内的服务端口(containerPort)，值(value)指定对应的NodePort端口(集群节点上开放的外部访问端口，范围30000-32767)。若值为空，则仅创建ClusterIP服务不开放NodePort。例如：8088:32088表示将容器的8088端口映射到集群节点的32088端口。",
      "configType": "k8s",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [],
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.services",
      "configLevel": "advanced"
    },
    {
      "name": "cluster_port_mappings",
      "label": "集群内部端口映射",
