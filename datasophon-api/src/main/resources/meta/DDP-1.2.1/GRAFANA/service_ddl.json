{
  "name": "GRAFANA",
  "label": "Grafana",
  "description": "监控分析与数据可视化套件",
  "version": "9.1.6",
  "sortNum": 17,
  "dependencies": [],
  "packageName": "grafana-9.1.6.tar.gz",
  "decompressPackageName": "grafana-9.1.6",
  "roles": [
    {
      "name": "Grafana",
      "label": "Grafana",
      "roleType": "master",
      "runAs": {
        "user": "root",
        "group": "root"
      },
      "cardinality": 1,
      "logFile": "data/log/grafana.log",
      "jmxPort": "3000",
      "startRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "start",
          "grafana"
        ]
      },
      "stopRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "stop",
          "grafana"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "status",
          "grafana"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "restart",
          "grafana"
        ]
      },
      "externalLink": {
        "name": "Grafana Ui",
        "label": "Grafana Ui",
        "url": "http://${host}:3000"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "svc.config.k8s",
        "fileDescription": "Grafana Kubernetes网络服务配置，定义端口",
        "configFormat": "properties",
        "configTargetRoles": "Grafana",
        "outputDirectory": "",
        "includeParams": [
          "portMappings"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "portMappings",
      "label": "端口映射 (portMappings)",
      "description": "定义容器与主机之间的端口映射关系，用于网络通信。key 表示 port 和 targetPort（port 和 targetPort 使用同一个端口），value 表示 nodePort。如果 value 为空，则表示不开放 nodePort。",
      "configType": "k8s",
      "required": false,
      "type": "multipleWithKey",
      "value": [
        {
          "3000": "30003"
        }
      ],
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": [
        {
          "3000": "30003"
        }
      ]
    }
  ]
}