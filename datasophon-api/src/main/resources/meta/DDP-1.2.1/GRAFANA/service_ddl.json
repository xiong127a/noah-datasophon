{
  "name": "GRAFANA",
  "label": "Grafana",
  "description": "监控分析与数据可视化套件",
  "version": "9.1.6",
  "sortNum": 17,
  "dependencies": [],
  "packageName": "grafana-9.1.6.tar.gz",
  "decompressPackageName": "grafana-9.1.6",
  "roles": [
    {
      "name": "Grafana",
      "label": "Grafana",
      "roleType": "master",
      "runAs": {
        "user": "root",
        "group": "root"
      },
      "cardinality": 1,
      "logFile": "data/log/grafana.log",
      "jmxPort": "3000",
      "startRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "start",
          "grafana"
        ]
      },
      "stopRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "stop",
          "grafana"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "status",
          "grafana"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "restart",
          "grafana"
        ]
      },
      "externalLink": {
        "name": "Grafana Ui",
        "label": "Grafana Ui",
        "url": "http://${hostname}:3000"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "grafana.ini",
        "fileDescription": "Grafana主配置文件",
        "configFormat": "properties",
        "configTargetRoles": "Grafana",
        "outputDirectory": "conf",
        "includeParams": [
          "custom.grafana.ini"
        ]
      },
      {
        "filename": "kubernetes.config.persistent-volume-claims",
        "fileDescription": "Grafana Kubernetes存储配置，定义持久卷存储类和挂载路径",
        "configFormat": "properties",
        "configTargetRoles": "Grafana",
        "outputDirectory": "",
        "includeParams": [
          "storage_classes",
          "mount_path",
          "storage_size"
        ]
      },
      {
        "filename": "kubernetes.config.services",
        "fileDescription": "Grafana Kubernetes网络服务配置，定义端口",
        "configFormat": "properties",
        "configTargetRoles": "Grafana",
        "outputDirectory": "",
        "includeParams": [
          "node_port_mappings",
          "cluster_port_mappings"
        ]
      },
      {
        "filename": "kubernetes.config.resources",
        "fileDescription": "cpu、memory系统资源",
        "configFormat": "properties",
        "configTargetRoles": "Grafana",
        "outputDirectory": "",
        "includeParams": [
          "requests_memory",
          "requests_cpu",
          "limits_memory",
          "limits_cpu"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "storage_classes",
      "label": "存储类名称",
      "description": "Kubernetes存储类名称，用于动态创建持久卷(PV)。需预先在集群中创建对应存储类（如nfs-client），确保与底层存储系统匹配",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "nfs-client",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "nfs-client",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.persistent-volume-claims",
      "configLevel": "advanced"
    },
    {
      "name": "mount_path",
      "label": "挂载路径",
      "description": "持久卷在Pod内的挂载路径，需与存储类配合使用。该路径将作为Grafana的数据存储位置的父目录",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "/opt/datasophon/grafana-9.1.6/data",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "/opt/datasophon/grafana-9.1.6/data",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.persistent-volume-claims",
      "configLevel": "advanced"
    },
    {
      "name": "storage_size",
      "label": "存储大小",
      "description": "持久卷的存储大小，需与存储类配合使用。例如：20Gi",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "10",
      "configurableInWizard": true,
      "hidden": false,
      "unit": "Gi",
      "defaultValue": "10",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.persistent-volume-claims",
      "configLevel": "advanced"
    },
    {
      "name": "requests_memory",
      "label": "内存请求值",
      "description": "容器启动时保证分配的最小内存量（如 2Gi）。建议设置为日常内存使用峰值的 1.2 倍，单位支持 Gi/Mi。",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "1",
      "unit": "Gi",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "requests_cpu",
      "label": "CPU 请求值",
      "description": "容器启动时保证分配的最小 CPU 核心数（如 1）。建议设置为日常 CPU 使用峰值的 1.5 倍，支持小数（如 0.5 表示 500m 毫核）。",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "0.5",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "0.5",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "limits_memory",
      "label": "内存限制值",
      "description": "容器允许使用的最大内存量（如 4Gi）。必须大于请求值，建议不超过请求值的 2 倍，否则可能引发 OOM Kill 风险。",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "2",
      "unit": "Gi",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "limits_cpu",
      "label": "CPU 限制值 (limits.cpu)",
      "description": "容器允许使用的最大 CPU 核心数（如 2）。建议设置为请求值的 2-3 倍以应对突发负载，但需确保节点资源充足。",
      "configType": "k8s",
      "required": false,
      "type": "input",
      "value": "1",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1",
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "node_port_mappings",
      "label": "NodePort端口映射",
      "description": "配置Kubernetes Service的NodePort类型端口映射，实现集群外部对服务的访问。键(key)指定容器内的服务端口(containerPort)，值(value)指定对应的NodePort端口(集群节点上开放的外部访问端口，范围30000-32767)。若值为空，则仅创建ClusterIP服务不开放NodePort。例如：3000:30003表示将容器的3000端口映射到集群节点的30003端口。",
      "configType": "k8s",
      "required": false,
      "type": "multipleWithKey",
      "value": [{"3000": "30003"}],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [{"3000": "30003"}],
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.services",
      "configLevel": "advanced"
    },
    {
      "name": "cluster_port_mappings",
      "label": "集群内部端口映射",
      "description": "配置Kubernetes Service的ClusterIP类型端口映射，仅用于集群内部通信。键(key)指定容器内的服务端口(containerPort)，值(value)通常与键相同，表示不需要特别映射。这些端口只能在Kubernetes集群内部访问，无法从外部直接访问。",
      "configType": "k8s",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [],
      "configCategory": "k8s",
      "configGroup": "kubernetes.config.services",
      "configLevel": "advanced"
    },
    {
      "name": "custom.grafana.ini",
      "label": "自定义Grafana配置",
      "description": "用于添加自定义的Grafana参数，这些参数将被添加到grafana.ini配置文件中",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "",
      "configCategory": "file",
      "configGroup": "grafana",
      "configLevel": "custom"
    }
  ]
}