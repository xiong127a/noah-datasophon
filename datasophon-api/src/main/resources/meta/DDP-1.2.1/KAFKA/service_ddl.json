{
  "name": "KAFKA",
  "label": "Kafka",
  "description": "高吞吐量的分布式发布订阅消息系统",
  "version": "2.4.1",
  "sortNum": 4,
  "dependencies": [
    "ZOOKEEPER"
  ],
  "packageName": "kafka-2.4.1.tar.gz",
  "decompressPackageName": "kafka-2.4.1",
  "roles": [
    {
      "name": "KafkaBroker",
      "label": "KafkaBroker",
      "roleType": "master",
      "cardinality": "1+",
      "logFile": "logs/server.log",
      "jmxPort": 9991,
      "startRunner": {
        "timeout": "60",
        "program": "bin/kafka-server-start.sh",
        "args": [
          "-daemon",
          "./config/server.properties"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "bin/kafka-server-stop.sh",
        "args": [

        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/kafka-server-status.sh",
        "args": [

        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "restart",
          "namenode"
        ]
      }
    },
    {
      "name": "efak",
      "label": "efak",
      "roleType": "worker",
      "cardinality": "1",
      "logFile": "efak/logs/log.log",
      "jmxPort": 18048,
      "startRunner": {
        "timeout": "60",
        "program": "efak/bin/ke.sh",
        "args": [
          "start"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "efak/bin/ke.sh",
        "args": [
          "stop"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "efak/bin/ke.sh",
        "args": [
          "status"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "efak/bin/ke.sh",
        "args": [
          "restart"
        ]
      },
      "externalLink": {
        "name": "efak Ui",
        "label": "efak Ui",
        "url": "http://${hostname}:8048"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "server.properties",
        "fileDescription": "Kafka服务器配置文件，定义Broker、Topic、日志存储等核心参数",
        "configTargetRoles": "KafkaBroker",
        "configFormat": "properties",
        "outputDirectory": "config",
        "includeParams": [
          "log.dirs",
          "num.partitions",
          "offsets.topic.replication.factor",
          "log.retention.hours",
          "zookeeper.connect",
          "default.replication.factor",
          "auto.create.topics.enable",
          "unclean.leader.election.enable",
          "auto.leader.rebalance.enable",
          "message.max.bytes",
          "replica.fetch.max.bytes",
          "num.network.threads",
          "num.io.threads",
          "replica.lag.time.max.ms",
          "num.replica.fetchers",
          "queued.max.requests",
          "socket.receive.buffer.bytes",
          "socket.send.buffer.bytes",
          "socket.request.max.bytes",
          "advertised.listeners",
          "listeners",
          "inter.broker.listener.name",
          "security.inter.broker.protocol",
          "sasl.mechanism.inter.broker.protocol",
          "sasl.enabled.mechanisms",
          "sasl.kerberos.service.name",
          "listener.security.protocol.map",
          "custom.server.properties"
        ]
      },
      {
        "filename": "system-config.properties",
        "fileDescription": "Kafka监控系统配置文件，定义EFAK监控参数和数据库连接信息",
        "configFormat": "properties",
        "configTargetRoles": "efak",
        "outputDirectory": "efak/conf",
        "includeParams": [
          "efak.zk.cluster.alias",
          "cluster1.zk.list",
          "cluster1.zk.acl.enable",
          "cluster1.zk.acl.schema",
          "cluster1.zk.acl.username",
          "cluster1.zk.acl.password",
          "cluster1.efak.broker.size",
          "kafka.zk.limit.size",
          "efak.webui.port",
          "efak.distributed.enable",
          "efak.cluster.mode.status",
          "efak.worknode.master.host",
          "efak.worknode.port",
          "cluster1.efak.jmx.acl",
          "cluster1.efak.jmx.user",
          "cluster1.efak.jmx.password",
          "cluster1.efak.jmx.ssl",
          "cluster1.efak.jmx.truststore.location",
          "cluster1.efak.jmx.truststore.password",
          "cluster1.efak.offset.storage",
          "cluster1.efak.jmx.uri",
          "efak.metrics.charts",
          "efak.metrics.retain",
          "efak.sql.topic.records.max",
          "efak.sql.topic.preview.records.max",
          "efak.topic.token",
          "cluster1.efak.sasl.enable",
          "cluster1.efak.sasl.protocol",
          "cluster1.efak.sasl.mechanism",
          "cluster1.efak.sasl.jaas.config",
          "cluster1.efak.sasl.client.id",
          "cluster1.efak.blacklist.topics",
          "cluster1.efak.sasl.cgroup.enable",
          "cluster1.efak.sasl.cgroup.topics",
          "efak.driver",
          "efak.url",
          "efak.username",
          "efak.password",
          "custom.system-config.properties"
        ]
      },
      {
        "filename": "kafka-server-start.sh",
        "fileDescription": "Kafka服务启动脚本，配置JVM参数和堆内存大小",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "bin",
        "templateName": "kafka-server-start.ftl",
        "includeParams": [
          "kafkaHeapSize",
          "JMX_PORT"
        ]
      },
      {
        "filename": "kafka-run-class.sh",
        "fileDescription": "Kafka类运行脚本，配置安全认证和Kerberos参数",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "bin",
        "templateName": "kafka-run-class.ftl",
        "includeParams": [
          "javaSecurityKrb5Conf",
          "javaSecurityAuthLoginConfig"
        ]
      },
      {
        "filename": "kafka-topics.sh",
        "fileDescription": "Kafka主题管理脚本，用于创建和管理Topic的命令行工具",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "bin",
        "templateName": "kafka-topics.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-console-consumer.sh",
        "fileDescription": "Kafka消费者脚本，用于消费和查看Topic数据的命令行工具",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "bin",
        "templateName": "kafka-console-consumer.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-console-producer.sh",
        "fileDescription": "Kafka生产者脚本，用于向Topic发送消息的命令行工具",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "bin",
        "templateName": "kafka-console-producer.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-consumer-groups.sh",
        "fileDescription": "Kafka消费者组管理脚本，用于管理和监控消费者组状态",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "bin",
        "templateName": "kafka-consumer-groups.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-jaas.conf",
        "fileDescription": "Kafka JAAS安全认证配置，定义Kerberos认证信息",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "config",
        "templateName": "kafka-jaas.ftl",
        "includeParams": [
          "kafkaHost",
          "kafkaRealm"
        ]
      },
      {
        "filename": "kafka-client-jaas.conf",
        "fileDescription": "Kafka客户端JAAS配置，定义客户端连接认证信息",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "config",
        "templateName": "kafka-client-jaas.ftl",
        "includeParams": [
          "kafkaHost",
          "kafkaRealm"
        ]
      },
      {
        "filename": "kafka-client.properties",
        "fileDescription": "Kafka客户端连接配置，定义安全协议和认证机制",
        "configFormat": "custom",
        "configTargetRoles": "KafkaBroker",
        "outputDirectory": "config",
        "templateName": "kafka-client.ftl",
        "includeParams": [
          "securityProtocol",
          "saslMechanism",
          "kbServiceName",
          "custom.kafka-client.properties"
        ]
      },
      {
        "filename": "kubernetes.config.persistent-volume-claims",
        "fileDescription": "Kafka Kubernetes存储配置，定义持久卷存储类和挂载路径",
        "configFormat": "properties",
        "configTargetRoles": "KafkaBroker,efak",
        "outputDirectory": "",
        "includeParams": [
          "storage_classes",
          "mount_path",
          "storage_size"
        ]
      },
      {
        "filename": "kubernetes.config.services",
        "fileDescription": "Kafka Kubernetes网络服务配置，定义端口映射和服务类型",
        "configFormat": "properties",
        "configTargetRoles": "KafkaBroker,efak",
        "outputDirectory": "",
        "includeParams": [
          "node_port_mappings",
          "cluster_port_mappings",
          "load_balancer_port_mappings"
        ]
      },
      {
        "filename": "kubernetes.config.resources",
        "fileDescription": "Kafka Kubernetes资源配置，定义CPU和内存资源限制",
        "configFormat": "properties",
        "configTargetRoles": "KafkaBroker,efak",
        "outputDirectory": "",
        "includeParams": [
          "requests_memory",
          "requests_cpu",
          "limits_memory",
          "limits_cpu"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "log.dirs",
      "label": "kafka数据存储目录",
      "description": "Kafka数据日志存储目录，支持多个路径以逗号分隔，用于存储Topic分区数据",
      "configType": "path",
      "required": true,
      "type": "input",
       "heightMultiple": 4,
      "separator": ",",
      "value": "/data/kafka-logs",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced"
    },
    {
      "name": "kafkaHeapSize",
      "label": "Kafka堆内存大小",
      "description": "Kafka Broker进程的JVM堆内存大小，影响Kafka的处理能力和稳定性",
      "configType": "map",
      "required": true,
      "minValue": 0,
      "maxValue": 24,
      "type": "slider",
      "value": "",
      "unit": "GB",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "6",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced"
    },
    {
      "name": "num.partitions",
      "label": "默认分区数",
      "description": "新创建Topic的默认分区数，影响Topic的并行度和性能",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "8",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "offsets.topic.replication.factor",
      "label": "内置Topic副本数",
      "description": "Kafka内置Topic（如__consumer_offsets）的副本数，建议设置为3以确保高可用",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "3",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "log.retention.hours",
      "label": "数据保留时间",
      "description": "Kafka日志数据保留的最长时间（小时），超过此时间的数据将被删除",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "168",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "zookeeper.connect",
      "label": "ZooKeeper连接地址",
      "description": "Kafka连接ZooKeeper集群的地址列表，格式为host1:port,host2:port/kafka",
      "required": true,
      "type": "input",
      "value": "${zkUrls}/kafka",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "securityProtocol",
      "label": "securityProtocol",
      "description": "",
      "configType": "map",
      "configWithKerberos": true,
      "required": false,
      "type": "input",
      "value": "SASL_PLAINTEXT",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": "SASL_PLAINTEXT",
      "configCategory": "file",
      "configGroup": "kafka-client",
      "configLevel": "advanced"
    },
    {
      "name": "default.replication.factor",
      "label": "默认Topic副本数",
      "description": "新创建Topic的默认副本数，影响数据可靠性和可用性",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "auto.create.topics.enable",
      "label": "启用自动创建Topic",
      "description": "是否允许生产者和消费者自动创建不存在的Topic",
      "required": true,
      "type": "switch",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false,
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "unclean.leader.election.enable",
      "label": "允许Unclean Leader选举",
      "description": "是否允许落后较多的副本参加Leader选举，可能导致数据丢失但提高可用性",
      "required": true,
      "type": "switch",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false,
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "auto.leader.rebalance.enable",
      "label": "启用Leader重平衡",
      "description": "是否允许Kafka定期对Topic分区进行Leader重选举以平衡负载",
      "required": true,
      "type": "switch",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true,
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "message.max.bytes",
      "label": "最大消息大小",
      "description": "Broker能够接收的单个消息最大字节数，影响大消息的处理能力",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "10000120",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "replica.fetch.max.bytes",
      "label": "副本同步最大消息大小",
      "description": "Broker副本同步时可复制的最大消息大小，必须大于等于message.max.bytes",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "10485760",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "num.network.threads",
      "label": "网络线程数",
      "description": "Broker处理网络请求的线程数，影响网络I/O性能",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "3",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced"
    },
    {
      "name": "num.io.threads",
      "label": "I/O线程数",
      "description": "Broker处理磁盘I/O请求的线程数，建议设置为磁盘数量",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "12",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced"
    },
    {
      "name": "num.replica.fetchers",
      "label": "副本同步线程数",
      "description": "副本拉取线程数，这个参数占总核数的50%的 1/3",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "12",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "replica.lag.time.max.ms",
      "label": "副本延迟最大时间",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "20000",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "queued.max.requests",
      "label": "等待执行的io请求最大数目",
      "description": "在网络线程停止读取新请求之前，可以排队等待I/O线程处理的最大请求个数。",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "500",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "socket.receive.buffer.bytes",
      "label": "socket接收服务的缓存区大小",
      "description": "socket接收服务的缓存区大小",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1024000",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "socket.send.buffer.bytes",
      "label": "socket发送服务的缓存区大小",
      "description": "socket发送服务的缓存区大小",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1024000",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "socket.request.max.bytes",
      "label": "socket每次请求的最大字节数",
      "description": "socket每次请求的最大字节数",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "102857600",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "enableKerberos",
      "label": "开启Kerberos认证",
      "description": "开启Kerberos认证",
      "required": false,
      "type": "switch",
      "value": false,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false,
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "advertised.listeners",
      "label": "Kafka对外广播地址",
      "description": "Kafka Broker对外广播的监听地址，客户端通过此地址连接Kafka",
      "required": true,
      "type": "input",
      "value": "PLAINTEXT://${hostname}:9092",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "PLAINTEXT://${hostname}:9092",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced",
      "bindRole": "KafkaBroker",
      "serviceType": "LoadBalancer",
      "portNumber": "9093"
    },
    {
      "name": "listener.security.protocol.map",
      "label": "Kafka监听协议",
      "description": "Kafka Broker监听协议配置，PLAINTEXT表示明文，SASL_PLAINTEXT表示SASL明文，SASL_SSL表示SASL加密，SSL表示加密",
      "required": true,
      "type": "input",
      "value": "PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced"
    },
    {
      "name": "listeners",
      "label": "Kafka监听地址",
      "description": "Kafka Broker的监听地址配置，定义服务绑定的网络接口和端口",
      "required": true,
      "type": "input",
      "value": "PLAINTEXT://0.0.0.0:9092,EXTERNAL://0.0.0.0:9093",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "PLAINTEXT://0.0.0.0:9092",
      "configCategory": "role",
      "configGroup": "KafkaBroker",
      "configLevel": "advanced",
      "bindRole": "KafkaBroker",
      "serviceType": "ClusterIP",
      "portNumber": "9092"
    },
    {
      "name": "inter.broker.listener.name",
      "label": "Broker间通信监听器名称",
      "description": "指定Broker之间通信使用的监听器名称，必须是advertised.listeners中定义的一个监听器名称",
      "required": true,
      "type": "input",
      "value": "PLAINTEXT",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "PLAINTEXT",
      "configCategory": "file",
      "configGroup": "server",
      "configLevel": "advanced"
    },
    {
      "name": "security.inter.broker.protocol",
      "label": "security.inter.broker.protocol",
      "description": "",
      "configType": "kb",
