{
  "name": "KAFKA",
  "label": "Kafka",
  "description": "高吞吐量的分布式发布订阅消息系统",
  "version": "2.4.1",
  "sortNum": 4,
  "dependencies": [
    "ZOOKEEPER"
  ],
  "packageName": "kafka-2.4.1.tar.gz",
  "decompressPackageName": "kafka-2.4.1",
  "roles": [
    {
      "name": "KafkaBroker",
      "label": "KafkaBroker",
      "roleType": "master",
      "cardinality": "1+",
      "logFile": "logs/server.log",
      "jmxPort": 9991,
      "startRunner": {
        "timeout": "60",
        "program": "bin/kafka-server-start.sh",
        "args": [
          "-daemon",
          "./config/server.properties"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "bin/kafka-server-stop.sh",
        "args": [

        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "bin/kafka-server-status.sh",
        "args": [

        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control.sh",
        "args": [
          "restart",
          "namenode"
        ]
      }
    },
    {
      "name": "efak",
      "label": "efak",
      "roleType": "worker",
      "cardinality": "1",
      "logFile": "efak/logs/log.log",
      "jmxPort": 18048,
      "startRunner": {
        "timeout": "60",
        "program": "efak/bin/ke.sh",
        "args": [
          "start"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "efak/bin/ke.sh",
        "args": [
          "stop"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "efak/bin/ke.sh",
        "args": [
          "status"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "efak/bin/ke.sh",
        "args": [
          "restart"
        ]
      },
      "externalLink": {
        "name": "efak Ui",
        "label": "efak Ui",
        "url": "http://${host}:8048"
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "server.properties",
        "configFormat": "properties",
        "outputDirectory": "config",
        "includeParams": [
          "log.dirs",
          "num.partitions",
          "offsets.topic.replication.factor",
          "log.retention.hours",
          "zookeeper.connect",
          "default.replication.factor",
          "auto.create.topics.enable",
          "unclean.leader.election.enable",
          "auto.leader.rebalance.enable",
          "message.max.bytes",
          "replica.fetch.max.bytes",
          "num.network.threads",
          "num.io.threads",
          "replica.lag.time.max.ms",
          "num.replica.fetchers",
          "queued.max.requests",
          "socket.receive.buffer.bytes",
          "socket.send.buffer.bytes",
          "socket.request.max.bytes",
          "advertised.listeners",
          "listeners",
          "security.inter.broker.protocol",
          "sasl.mechanism.inter.broker.protocol",
          "sasl.enabled.mechanisms",
          "sasl.kerberos.service.name",
          "custom.server.properties"
        ]
      },
      {
        "filename": "system-config.properties",
        "configFormat": "properties",
        "outputDirectory": "efak/conf",
        "includeParams": [
          "efak.zk.cluster.alias",
          "cluster1.zk.list",
          "cluster1.zk.acl.enable",
          "cluster1.zk.acl.schema",
          "cluster1.zk.acl.username",
          "cluster1.zk.acl.password",
          "cluster1.efak.broker.size",
          "kafka.zk.limit.size",
          "efak.webui.port",
          "efak.distributed.enable",
          "efak.cluster.mode.status",
          "efak.worknode.master.host",
          "efak.worknode.port",
          "cluster1.efak.jmx.acl",
          "cluster1.efak.jmx.user",
          "cluster1.efak.jmx.password",
          "cluster1.efak.jmx.ssl",
          "cluster1.efak.jmx.truststore.location",
          "cluster1.efak.jmx.truststore.password",
          "cluster1.efak.offset.storage",
          "cluster1.efak.jmx.uri",
          "efak.metrics.charts",
          "efak.metrics.retain",
          "efak.sql.topic.records.max",
          "efak.sql.topic.preview.records.max",
          "efak.topic.token",
          "cluster1.efak.sasl.enable",
          "cluster1.efak.sasl.protocol",
          "cluster1.efak.sasl.mechanism",
          "cluster1.efak.sasl.jaas.config",
          "cluster1.efak.sasl.client.id",
          "cluster1.efak.blacklist.topics",
          "cluster1.efak.sasl.cgroup.enable",
          "cluster1.efak.sasl.cgroup.topics",
          "efak.driver",
          "efak.url",
          "efak.username",
          "efak.password"
        ]
      },
      {
        "filename": "kafka-server-start.sh",
        "configFormat": "custom",
        "outputDirectory": "bin",
        "templateName": "kafka-server-start.ftl",
        "includeParams": [
          "kafkaHeapSize",
          "JMX_PORT"
        ]
      },

      {
        "filename": "kafka-run-class.sh",
        "configFormat": "custom",
        "outputDirectory": "bin",
        "templateName": "kafka-run-class.ftl",
        "includeParams": [
          "javaSecurityKrb5Conf",
          "javaSecurityAuthLoginConfig"
        ]
      },
      {
        "filename": "kafka-topics.sh",
        "configFormat": "custom",
        "outputDirectory": "bin",
        "templateName": "kafka-topics.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-console-consumer.sh",
        "configFormat": "custom",
        "outputDirectory": "bin",
        "templateName": "kafka-console-consumer.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-console-producer.sh",
        "configFormat": "custom",
        "outputDirectory": "bin",
        "templateName": "kafka-console-producer.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-consumer-groups.sh",
        "configFormat": "custom",
        "outputDirectory": "bin",
        "templateName": "kafka-consumer-groups.ftl",
        "includeParams": [
          "kafkaHome"
        ]
      },
      {
        "filename": "kafka-jaas.conf",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "kafka-jaas.ftl",
        "includeParams": [
          "kafkaHost",
          "kafkaRealm"
        ]
      },
      {
        "filename": "kafka-client-jaas.conf",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "kafka-client-jaas.ftl",
        "includeParams": [
          "kafkaHost",
          "kafkaRealm"
        ]
      },
      {
        "filename": "kafka-client.properties",
        "configFormat": "custom",
        "outputDirectory": "config",
        "templateName": "kafka-client.ftl",
        "includeParams": [
          "securityProtocol",
          "saslMechanism",
          "kbServiceName"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "log.dirs",
      "label": "kafka数据存储目录",
      "description": "",
      "required": true,
      "type": "multiple",
      "separator": ",",
      "value": [
        "/data/kafka-logs"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "kafkaHeapSize",
      "label": "Kafka堆内存大小",
      "description": "Kafka堆内存大小",
      "configType": "map",
      "required": true,
      "minValue": 0,
      "maxValue": 24,
      "type": "slider",
      "value": "",
      "unit": "GB",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "6"
    },
    {
      "name": "num.partitions",
      "label": "分区数",
