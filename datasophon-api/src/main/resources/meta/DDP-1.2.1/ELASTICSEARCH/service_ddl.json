{
  "name": "ELASTICSEARCH",
  "label": "ElasticSearch",
  "description": "高性能搜索引擎",
  "version": "7.16.2",
  "sortNum": 11,
  "dependencies": [],
  "packageName": "elasticsearch-7.16.2.tar.gz",
  "decompressPackageName": "elasticsearch-7.16.2",
  "roles": [
    {
      "name": "ElasticSearch",
      "label": "ElasticSearch",
      "roleType": "master",
      "cardinality": "1+",
      "logFile": "logs/ddp_es.log",
      "runAs": {
        "user": "elastic",
        "group": "elastic"
      },
      "sortNum": 1,
      "startRunner": {
        "timeout": "60",
        "program": "bin/elasticsearch",
        "args": [
          "-d",
          "-p",
          "pid/elasticsearch.pid"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "control_es.sh",
        "args": [
          "stop",
          "elasticsearch"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "control_es.sh",
        "args": [
          "status",
          "elasticsearch"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "control_es.sh",
        "args": [
          "restart",
          "elasticsearch"
        ]
      }
    },
    {
      "name": "EsExporter",
      "label": "EsExporter",
      "roleType": "master",
      "cardinality": "1",
      "logFile": "elasticsearch-exporter/logs/es_exporter-${hostname}.out",
      "jmxPort": 9114,
      "sortNum": 2,
      "startRunner": {
        "timeout": "60",
        "program": "elasticsearch-exporter/control_es_exporter.sh",
        "args": [
          "start",
          "es_exporter"
        ]
      },
      "stopRunner": {
        "timeout": "600",
        "program": "elasticsearch-exporter/control_es_exporter.sh",
        "args": [
          "stop",
          "es_exporter"
        ]
      },
      "statusRunner": {
        "timeout": "60",
        "program": "elasticsearch-exporter/control_es_exporter.sh",
        "args": [
          "status",
          "es_exporter"
        ]
      },
      "restartRunner": {
        "timeout": "60",
        "program": "elasticsearch-exporter/control_es_exporter.sh",
        "args": [
          "restart",
          "es_exporter"
        ]
      }
    }
  ],
  "configWriter": {
    "generators": [
      {
        "filename": "elasticsearch.yml",
        "fileDescription": "ElasticSearch核心配置文件，定义集群节点、网络和存储参数",
        "configFormat": "properties3",
        "configTargetRoles": "ElasticSearch",
        "outputDirectory": "config",
        "includeParams": [
          "cluster.name",
          "node.name",
          "node.master",
          "network.host",
          "http.port",
          "transport.tcp.port",
          "transport.tcp.compress",
          "discovery.seed_hosts",
          "discovery.zen.minimum_master_nodes",
          "cluster.initial_master_nodes",
          "gateway.recover_after_nodes",
          "http.cors.enabled",
          "http.cors.allow-origin",
          "http.cors.allow-headers",
          "path.data",
          "xpack.security.enabled",
          "custom.elasticsearch.yml"
        ]
      },
      {
        "filename": "jvm.options",
        "fileDescription": "ElasticSearch JVM配置文件，设置堆内存大小和垃圾回收参数",
        "configFormat": "custom",
        "outputDirectory": "",
        "templateName": "jvm.options.ftl",
        "includeParams": [
          "heapSize"
        ]
      },
      {
        "filename": "kubernetes.config.persistent-volume-claims",
        "fileDescription": "ElasticSearch Kubernetes存储配置，定义持久卷存储类和挂载路径",
        "configFormat": "properties",
        "configTargetRoles": "ElasticSearch",
        "outputDirectory": "",
        "includeParams": [
          "storage_classes",
          "mount_path",
          "storage_size"
        ]
      },
      {
        "filename": "kubernetes.config.services",
        "fileDescription": "ElasticSearch Kubernetes网络服务配置，定义端口",
        "configFormat": "properties",
        "configTargetRoles": "ElasticSearch,EsExporter",
        "outputDirectory": "",
        "includeParams": [
          "node_port_mappings",
          "cluster_port_mappings"
        ]
      },
      {
        "filename": "kubernetes.config.resources",
        "fileDescription": "cpu、memory系统资源",
        "configFormat": "properties",
        "configTargetRoles": "ElasticSearch,EsExporter",
        "outputDirectory": "",
        "includeParams": [
          "requests_memory",
          "requests_cpu",
          "limits_memory",
          "limits_cpu"
        ]
      }
    ]
  },
  "parameters": [
    {
      "name": "cluster.name",
      "label": "集群名称",
      "description": "ElasticSearch集群的名称，需在同一个集群中的所有节点保持一致",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "ddp_es",
      "configCategory": "file",
      "configGroup": "elasticsearch.yml",
      "configLevel": "advanced"
    },
    {
      "name": "node.name",
      "label": "节点名称",
      "description": "ElasticSearch节点的唯一标识，建议使用主机名${hostname}",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${hostname}",
      "configCategory": "file",
      "configGroup": "elasticsearch.yml",
      "configLevel": "advanced"
    },
    {
      "name": "node.master",
      "label": "是否竞选主节点",
      "description": "是不是有资格竞选主节点",
      "required": true,
      "type": "switch",
      "value": "true",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true
    },
    {
      "name": "network.host",
      "label": "节点地址",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${hostname}"
    },
    {
      "name": "http.port", 
      "label": "对外服务端口",
      "description": "对外提供服务的端口",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "9200",
      "configCategory": "file",
      "configGroup": "elasticsearch.yml",
      "configLevel": "advanced",
      "bindRole": "ElasticSearch",
      "serviceType": "NodePort",
      "portNumber": "9200",
      "nodePort": "30200"
    },
    {
      "name": "transport.tcp.port",
      "label": "集群通信端口",
      "description": "ElasticSearch节点间通信使用的TCP端口，必须在所有节点保持一致",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "9300",
      "configCategory": "file",
      "configGroup": "elasticsearch.yml",
      "configLevel": "advanced",
      "bindRole": "ElasticSearch",
      "serviceType": "NodePort",
      "portNumber": "9300",
      "nodePort": "30300"
    },
    {
      "name": "transport.tcp.compress",
      "label": "数据传输是否压缩",
      "description": "设置是否压缩tcp传输时的数据，默认为false，不压缩",
      "required": true,
      "type": "switch",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "discovery.seed_hosts",
      "label": "服务发现种子主机",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${seedHosts}"
    },
    {
      "name": "discovery.zen.minimum_master_nodes",
      "label": "discovery.zen.minimum_master_nodes",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2"
    },
    {
      "name": "cluster.initial_master_nodes",
      "label": "初始主节点",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "${initMasterNodes}"
    },
    {
      "name": "http.cors.enabled",
      "label": "是否可跨域",
      "description": "",
      "required": true,
      "type": "switch",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": true
    },
    {
      "name": "http.cors.allow-origin",
      "label": "支持的跨域范围",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "\"*\""
    },
    {
      "name": "http.cors.allow-headers",
      "label": "支持的header",
      "description": "",
      "required": true,
      "type": "input",
      "value": "",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "\"*\""
    },
    {
      "name": "heapSize",
      "label": "ES堆内存大小",
      "description": "ElasticSearch JVM堆内存大小，建议设置为不超过物理内存的一半",
      "required": false,
      "type": "input",
      "value": "",
      "unit": "GB",
      "configurableInWizard": true,
      "hidden": true,
      "defaultValue": "2",
      "configCategory": "file",
      "configGroup": "jvm.options",
      "configLevel": "advanced"
    },
    {
      "name": "path.data",
      "label": "数据存储目录",
      "description": "ElasticSearch数据存储目录，可以配置多个路径(用逗号分隔)实现数据条带化",
      "configType": "path",
      "separator": ",",
      "required": true,
      "type": "multiple",
      "value": [
        "/data/es"
      ],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "/data/es",
      "configCategory": "file",
      "configGroup": "elasticsearch.yml",
      "configLevel": "advanced"
    },
    {
      "name": "xpack.security.enabled",
      "label": "启用安全选项",
      "description": "",
      "required": true,
      "type": "switch",
      "value": false,
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": false
    },
    {
      "name": "custom.elasticsearch.yml",
      "label": "自定义配置elasticsearch.yml",
      "description": "自定义配置",
      "configType": "custom",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": ""
    },
    {
      "name": "storage_classes",
      "label": "存储类名称",
      "description": "Kubernetes存储类名称，用于动态创建持久卷(PV)。需预先在集群中创建对应存储类（如nfs-client），确保与底层存储系统匹配",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "nfs-client",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "nfs-client",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.persistent-volume-claims",
      "configLevel": "advanced"
    },
    {
      "name": "mount_path",
      "label": "挂载路径",
      "description": "持久卷在Pod内的挂载路径，需与存储类配合使用。该路径将作为ES的数据存储位置",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "/data",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "/data",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.persistent-volume-claims",
      "configLevel": "advanced"
    },
    {
      "name": "storage_size",
      "label": "存储大小",
      "description": "持久卷的存储大小，需与存储类配合使用。例如：20Gi",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "20",
      "configurableInWizard": true,
      "hidden": false,
      "unit": "Gi",
      "defaultValue": "20",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.persistent-volume-claims",
      "configLevel": "advanced"
    },
    {
      "name": "requests_memory",
      "label": "内存请求值",
      "description": "容器启动时保证分配的最小内存量（如 2Gi）。建议设置为日常内存使用峰值的 1.2 倍，单位支持 Gi/Mi。",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "2",
      "unit": "Gi",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "requests_cpu",
      "label": "CPU 请求值",
      "description": "容器启动时保证分配的最小 CPU 核心数（如 1）。建议设置为日常 CPU 使用峰值的 1.5 倍，支持小数（如 0.5 表示 500m 毫核）。",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "1",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "1",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "limits_memory",
      "label": "内存限制值",
      "description": "容器允许使用的最大内存量（如 4Gi）。必须大于请求值，建议不超过请求值的 2 倍，否则可能引发 OOM Kill 风险。",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "4",
      "unit": "Gi",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "4",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "limits_cpu",
      "label": "CPU 限制值 (limits.cpu)",
      "description": "容器允许使用的最大 CPU 核心数（如 2）。建议设置为请求值的 2-3 倍以应对突发负载，但需确保节点资源充足。",
      "configType": "kubernetes",
      "required": false,
      "type": "input",
      "value": "2",
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": "2",
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.resources",
      "configLevel": "advanced"
    },
    {
      "name": "cluster_port_mappings",
      "label": "集群内部端口映射",
      "description": "ElasticSearch集群内部通信端口配置",
      "configType": "kubernetes",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [],
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.services",
      "configLevel": "advanced"
    },
    {
      "name": "node_port_mappings",
      "label": "NodePort端口映射",
      "description": "配置Kubernetes Service的NodePort类型端口映射，实现集群外部对服务的访问",
      "configType": "kubernetes",
      "required": false,
      "type": "multipleWithKey",
      "value": [],
      "configurableInWizard": true,
      "hidden": false,
      "defaultValue": [],
      "configCategory": "kubernetes",
      "configGroup": "kubernetes.config.services",
      "configLevel": "advanced"
    }
  ]
}