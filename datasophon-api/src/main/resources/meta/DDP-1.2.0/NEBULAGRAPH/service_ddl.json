{
    "name": "NEBULAGRAPH",
    "label": "NebulaGraph",
    "description": "开源分布式图数据库,万亿级数据,毫秒级延时",
    "version": "3.8.0",
    "sortNum": 40,
    "dependencies": [

    ],
    "packageName": "nebula-graph-3.8.0.tar.gz",
    "decompressPackageName": "nebula-graph-3.8.0",
    "roles": [
        {
            "name": "Meta",
            "label": "Meta",
            "roleType": "master",
            "cardinality": "1+",
            "logFile": "logs/nebula-metad.INFO",
            "jmxPort": 19559,
            "startRunner": {
                "timeout": "1200",
                "program": "scripts/nebula.service",
                "args": [
                    "start",
                    "metad"
                ]
            },
            "stopRunner": {
                "timeout": "1200",
                "program": "scripts/nebula.service",
                "args": [
                    "stop",
                    "metad"
                ]
            },
            "statusRunner": {
                "timeout": "120",
                "program": "scripts/nebula.service",
                "args": [
                    "status",
                    "metad"
                ]
            }
        },
        {
            "name": "Graph",
            "label": "Graph",
            "roleType": "worker",
            "cardinality": "1+",
            "logFile": "logs/nebula-graphd.INFO",
            "jmxPort": 19669,
            "startRunner": {
                "timeout": "1200",
                "program": "scripts/nebula.service",
                "args": [
                    "start",
                    "graphd"
                ]
            },
            "stopRunner": {
                "timeout": "1200",
                "program": "scripts/nebula.service",
                "args": [
                    "stop",
                    "graphd"
                ]
            },
            "statusRunner": {
                "timeout": "120",
                "program": "scripts/nebula.service",
                "args": [
                    "status",
                    "graphd"
                ]
            }
        },
        {
            "name": "Storage",
            "label": "Storage",
            "roleType": "worker",
            "cardinality": "1+",
            "logFile": "logs/nebula-storaged.INFO",
            "jmxPort": 19779,
            "startRunner": {
                "timeout": "1200",
                "program": "scripts/nebula.service",
                "args": [
                    "start",
                    "storaged"
                ]
            },
            "stopRunner": {
                "timeout": "1200",
                "program": "scripts/nebula.service",
                "args": [
                    "stop",
                    "storaged"
                ]
            },
            "statusRunner": {
                "timeout": "120",
                "program": "scripts/nebula.service",
                "args": [
                    "status",
                    "storaged"
                ]
            }
        },
        {
            "name": "Studio",
            "label": "Studio",
            "roleType": "worker",
            "cardinality": "1",
            "logFile": "nebula-graph-studio/logs/access.log",
            "startRunner": {
                "timeout": "1200",
                "program": "scripts/studio.service",
                "args": [
                    "start"
                ]
            },
            "stopRunner": {
                "timeout": "1200",
                "program": "scripts/studio.service",
                "args": [
                    "stop"
                ]
            },
            "statusRunner": {
                "timeout": "120",
                "program": "scripts/studio.service",
                "args": [
                    "status"
                ]
            },
            "externalLink": {
                "name": "NebulaGraph Studio UI",
                "label": "Studio UI",
                "url": "http://${host}:7001"
            }
        }
    ],
    "configWriter": {
        "generators": [
            {
                "filename": "nebula-metad.conf",
                "configFormat": "custom",
                "templateName": "nebula-metad.ftl",
                "outputDirectory": "etc",
                "includeParams": [
                    "metaServerAddrs",
                    "metaPort",
                    "localIp",
                    "metaDataPath",
                    "logDir",
                    "custom.metad.conf"
                ]
            },
            {
                "filename": "nebula-graphd.conf",
                "configFormat": "custom",
                "outputDirectory": "etc",
                "templateName": "nebula-graphd.ftl",
                "includeParams": [
                    "metaServerAddrs",
                    "graphPort",
                    "maxAllowedQuerySize",
                    "localIp",
                    "logDir",
                    "graphNumMaxConnections",
                    "graphNumWorkerThreads",
                    "enableAuthorize",
                    "authType",
                    "systemMemoryHighWatermarkRatio",
                    "udfPath",
                    "enableDataBalance",
                    "maxSessionsPerIpPerUser",
                    "graphMemoryTrackerLimitRatio",
                    "graphMemoryTrackerUntrackedReservedMemoryMb",
                    "graphMemoryPurgeEnabled",
                    "graphMemoryPurgeIntervalSeconds",
                    "maxJobSize",
                    "minBatchSize",
                    "optimizeAppendvertices",
                    "pathBatchSize",
                    "custom.graphd.conf"
                ]
            },
            {
                "filename": "nebula-storaged.conf",
                "configFormat": "custom",
                "templateName": "nebula-storaged.ftl",
                "outputDirectory": "etc",
                "includeParams": [
                    "metaServerAddrs",
                    "storagePort",
                    "localIp",
                    "logDir",
                    "storageDataPath",
                    "minimumReservedBytes",
                    "engineType",
                    "rocksdbBatchSize",
                    "rocksdbBlockCache",
                    "rocksdbCompression",
                    "rocksdbCompressionPerLevel",
                    "rocksdbDbOptions",
                    "rocksdbColumnFamilyOptions",
                    "rocksdbBlockBasedTableOptions",
                    "numIoThreads",
                    "storageNumMaxConnections",
                    "storageNumWorkerThreads",
                    "maxConcurrentSubtasks",
                    "storageMemoryTrackerLimitRatio",
                    "storageMemoryTrackerUntrackedReservedMemoryMb",
                    "storageMemoryPurgeEnabled",
                    "storageMemoryPurgeIntervalSeconds",
                    "custom.storaged.conf"
                ]
            }
        ]
    },
