<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.datasophon</groupId>
        <artifactId>datasophon</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>datasophon-api</artifactId>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- 默认复制前端资源 -->
        <skip.frontend.copy>false</skip.frontend.copy>
    </properties>
    <dependencies>
        <!-- 依赖业务服务层 -->
        <dependency>
            <groupId>com.datasophon</groupId>
            <artifactId>datasophon-service</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 依赖公共模块 -->
        <dependency>
            <groupId>com.datasophon</groupId>
            <artifactId>datasophon-common</artifactId>
            <version>${revision}</version>
        </dependency>
        
        <!-- 插件生态系统依赖 -->
        <dependency>
            <groupId>com.datasophon</groupId>
            <artifactId>datasophon-plugin-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.datasophon</groupId>
            <artifactId>datasophon-plugin-manager</artifactId>
            <version>${revision}</version>
        </dependency>
        
        <!-- Spring Boot Web相关 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        
        <!-- 移除对K8s模块的直接依赖，K8s由service层调用 -->
        <!-- ui 工程打包是一个空包，这里依赖主要是让 ui 先编译，这样前端就能自动打包到 tar 介质 -->
        <dependency>
            <groupId>com.datasophon</groupId>
            <artifactId>datasophon-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
<!--        <dependency>-->
<!--            <groupId>com.norinrd</groupId>-->
<!--            <artifactId>gt-sso-client-starter</artifactId>-->
<!--            <version>3.2.15-SNAPSHOT</version>-->
<!--            <exclusions>-->
<!--                <exclusion>-->
<!--                    <groupId>com.dtflys.forest</groupId>-->
<!--                    <artifactId>forest-spring-boot-starter</artifactId>-->
<!--                </exclusion>-->
<!--                <exclusion>-->
<!--                    <groupId>com.dtflys.forest</groupId>-->
<!--                    <artifactId>forest-core</artifactId>-->
<!--                </exclusion>-->
<!--            </exclusions>-->
<!--        </dependency>-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Janino dependency for Logback conditional expressions -->
        <dependency>
            <groupId>org.codehaus.janino</groupId>
            <artifactId>janino</artifactId>
        </dependency>

        <!-- JWT支持 - 升级到最新版本支持JDK21 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 添加Flyway依赖 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        
        <!-- MapStruct 对象转换框架 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>front/**</exclude><!-- 替换为您要排除的文件夹名 -->
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Maven编译插件配置MapStruct注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <!-- 启用参数名保留，支持Spring参数名反射 -->
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- Lombok和MapStruct一起使用的适配器 -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <excludes>
                        <exclude>db/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/src/main/resources</directory>
                            <includes>
                                <include>front/**</include><!-- 替换为要删除的文件名 -->
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- 打包后的包名是否包含assembly的id -->
                    <appendAssemblyId>false</appendAssemblyId>
                    <!-- 指定最后tar或者zip包的名字 -->
                    <finalName>datasophon-manager-${project.version}</finalName>
                    <!-- tar或者zip包的输出目录 -->
                    <outputDirectory>${project.basedir}/target/</outputDirectory>
                    <!-- 设置长文件名处理模式为gnu，避免长路径警告 -->
                    <tarLongFileMode>gnu</tarLongFileMode>
                    <descriptors>
                        <!-- 引用的assembly配置文件-->
                        <descriptor>${project.basedir}/src/main/resources/assembly.xml</descriptor>
                    </descriptors>
                    <archive>
                        <manifest>
                            <mainClass/>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <!-- phase加入package后，则在执行maven package时就可以调用maven-assembly-plugin插件定义的打包方式 -->
                    <execution>
                        <!--名字任意 -->
                        <id>make-assembly</id>
                        <goals>
                            <!-- 只运行一次 -->
                            <goal>single</goal>
                        </goals>
                        <!-- 绑定到package生命周期阶段 -->
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-image</goal>
                        </goals>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
                <version>0.40.2</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
<!--            <plugin>-->
<!--                <groupId>org.eclipse.transformer</groupId>-->
<!--                <artifactId>transformer-maven-plugin</artifactId>-->
<!--                <version>1.0.0</version>-->
<!--                <executions>-->
<!--                    <execution>-->
<!--                        <phase>process-classes</phase> &lt;!&ndash; 在编译后执行 &ndash;&gt;-->
<!--                        <goals>-->
<!--                            <goal>run</goal>-->
<!--                        </goals>-->
<!--                        <configuration>-->
<!--                            <inputDir>${project.build.directory}</inputDir>-->
<!--                            <outputDir>${project.build.directory}</outputDir>-->
<!--                            <rules>-->
<!--                                <rule>-->
<!--                                    <type>jakarta</type>-->
<!--                                </rule>-->
<!--                            </rules>-->
<!--                        </configuration>-->
<!--                    </execution>-->
<!--                </executions>-->
<!--            </plugin>-->
        </plugins>
    </build>

    <profiles>
        <!-- Docker镜像构建 - API -->
        <profile>
            <id>docker</id>
            <properties>
                <docker.skip>false</docker.skip>
                <docker.registry>harbor.norintech.com</docker.registry>
                <docker.host>tcp://localhost:2375</docker.host>
                <docker.tag>latest</docker.tag>
            </properties>
            <build>
                <plugins>
                    <!-- 准备 Docker 构建上下文 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>prepare-docker-context</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/docker-context</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/target</directory>
                                            <includes>
                                                <include>datasophon-manager-*.tar.gz</include>
                                            </includes>
                                            <targetPath>datasophon-api/target</targetPath>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 使用ant插件复制Dockerfile-api -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>copy-dockerfile</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <copy file="../Dockerfile-api"
                                              tofile="${project.build.directory}/docker-context/Dockerfile-api"/>
                                        <echo>Copied Dockerfile-api to ${project.build.directory}/docker-context/</echo>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <skip>${docker.skip}</skip>
                            <registry>${docker.registry}</registry>
                            <dockerHost>${docker.host}</dockerHost>
                            <authConfig>
                                <push>
                                    <username>noah</username>
                                    <password>Jd2019@123</password>
                                </push>
                            </authConfig>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-api-image</id>
                                <!-- 绑定到package阶段，确保API构建完成后执行 -->
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                    <goal>push</goal>
                                </goals>
                                <configuration>
                                    <images>
                                        <image>
                                            <name>${docker.registry}/bdp/datasophon-manager:${docker.tag}</name>
                                            <build>
                                                <contextDir>${project.build.directory}/docker-context</contextDir>
                                                <dockerFile>Dockerfile-api</dockerFile>
                                                <nocache>true</nocache>
                                                <optimise>true</optimise>
                                                <cleanup>true</cleanup>
                                            </build>
                                        </image>
                                    </images>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- 新增控制前端资源复制的profile -->
        <profile>
            <id>skip-frontend</id>
            <properties>
                <skip.frontend.copy>true</skip.frontend.copy>
            </properties>
            <!-- 添加激活条件，当父项目的skip.frontend.build为true时激活 -->
            <activation>
                <property>
                    <name>skip.frontend.build</name>
                    <value>true</value>
                </property>
            </activation>
            <!-- 添加构建配置，使用不同的assembly文件 -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <!-- 指定使用不包含前端资源的assembly文件 -->
                            <descriptors>
                                <descriptor>${project.basedir}/src/main/resources/assembly-no-frontend.xml</descriptor>
                            </descriptors>
                            <!-- 设置长文件名处理模式为gnu，避免长路径警告 -->
                            <tarLongFileMode>gnu</tarLongFileMode>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
