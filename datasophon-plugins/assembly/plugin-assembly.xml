<?xml version="1.0" encoding="UTF-8"?>
<!--
  DataSophon插件统一打包配置
  用于生成PF4J兼容的插件JAR包
  
  修改记录：
  - 2025-08-28: 改为Fat JAR方式，解决插件类加载器依赖问题
-->
<assembly xmlns="http://maven.apache.org/SCHEMA/ASSEMBLY/2.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SCHEMA/ASSEMBLY/2.0.0 
          http://maven.apache.org/xsd/assembly-2.0.0.xsd">

    <id>plugin</id>
    <formats>
        <format>jar</format>
    </formats>

    <!-- 不包含根目录 -->
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- 包含编译后的类文件 -->
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>**/*.class</include>
                <include>**/*.properties</include>
                <include>**/extensions.idx</include>
                <include>META-INF/**</include>
            </includes>
        </fileSet>
    </fileSets>

    <!-- 将依赖直接解压到插件JAR根目录（Fat JAR方式） -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <unpack>true</unpack>
            <excludes>
                <exclude>com.datasophon:datasophon-plugin-api</exclude>
                <exclude>org.pf4j:pf4j</exclude>
                <exclude>org.slf4j:slf4j-api</exclude>
                <exclude>org.projectlombok:lombok</exclude>
            </excludes>
            <unpackOptions>
                <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>META-INF/NOTICE*</exclude>
                    <exclude>META-INF/DEPENDENCIES*</exclude>
                </excludes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>

</assembly>
